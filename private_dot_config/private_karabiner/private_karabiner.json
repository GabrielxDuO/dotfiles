                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "<right_command> := alone ? without <comma> -> <f19> : <hyper>",
                        "manipulators": [
                            {
                                "from": {
